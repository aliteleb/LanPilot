<Application x:Class="LanPilot.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:LanPilot.App"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
                <ResourceDictionary Source="Styles/Colors.xaml" />
                <ResourceDictionary Source="Styles/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <local:BooleanVisibilityConverter x:Key="BooleanVisibilityConverter" />
            <local:InverseBooleanVisibilityConverter x:Key="InverseBooleanVisibilityConverter" />
            <local:BooleanOpacityConverter x:Key="BooleanOpacityConverter" />
            <local:RateLimitDisplayConverter x:Key="RateLimitDisplayConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>

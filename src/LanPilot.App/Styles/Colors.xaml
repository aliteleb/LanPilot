<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="PilotWindowBaseColor">#E913171B</Color>
    <Color x:Key="PilotBackgroundColor">#8F151A22</Color>
    <Color x:Key="PilotRailColor">#B512171B</Color>
    <Color x:Key="PilotRailHoverColor">#18FFFFFF</Color>
    <Color x:Key="PilotSecondaryHoverColor">#1FFFFFFF</Color>
    <Color x:Key="PilotRailSelectedColor">#2DFFFFFF</Color>
    <Color x:Key="PilotSurfaceColor">#70272C35</Color>
    <Color x:Key="PilotSurfaceSoftColor">#5A303645</Color>
    <Color x:Key="PilotRouterRowColor">#286D9EFF</Color>
    <Color x:Key="PilotDialogSurfaceColor">#FC171B22</Color>
    <Color x:Key="PilotBorderColor">#24FFFFFF</Color>
    <Color x:Key="PilotPrimaryColor">#6D9EFF</Color>
    <Color x:Key="PilotPrimaryHoverColor">#83B1FF</Color>
    <Color x:Key="PilotTextPrimaryColor">#F7F8FC</Color>
    <Color x:Key="PilotTextSecondaryColor">#C2C7D4</Color>
    <Color x:Key="PilotMenuSurfaceColor">#F02A2E36</Color>
    <Color x:Key="PilotMenuBorderColor">#34FFFFFF</Color>
    <Color x:Key="PilotMenuHoverColor">#18FFFFFF</Color>
    <Color x:Key="PilotMenuTextColor">#F6F7FB</Color>
    <Color x:Key="PilotMenuMutedTextColor">#6F737D</Color>
    <Color x:Key="PilotMenuIconColor">#C9CED8</Color>
    <Color x:Key="PilotSuccessColor">#40C48A</Color>
    <Color x:Key="PilotWarningColor">#F59E0B</Color>
    <Color x:Key="PilotInfoColor">#0891B2</Color>
    <Color x:Key="PilotDangerColor">#FF4E64</Color>

    <SolidColorBrush x:Key="PilotWindowBaseBrush" Color="{StaticResource PilotWindowBaseColor}" />
    <SolidColorBrush x:Key="PilotBackgroundBrush" Color="{StaticResource PilotBackgroundColor}" />
    <SolidColorBrush x:Key="PilotRailBrush" Color="{StaticResource PilotRailColor}" />
    <SolidColorBrush x:Key="PilotRailHoverBrush" Color="{StaticResource PilotRailHoverColor}" />
    <SolidColorBrush x:Key="PilotSecondaryHoverBrush" Color="{StaticResource PilotSecondaryHoverColor}" />
    <SolidColorBrush x:Key="PilotRailSelectedBrush" Color="{StaticResource PilotRailSelectedColor}" />
    <SolidColorBrush x:Key="PilotSurfaceBrush" Color="{StaticResource PilotSurfaceColor}" />
    <SolidColorBrush x:Key="PilotSurfaceSoftBrush" Color="{StaticResource PilotSurfaceSoftColor}" />
    <SolidColorBrush x:Key="PilotRouterRowBrush" Color="{StaticResource PilotRouterRowColor}" />
    <SolidColorBrush x:Key="PilotDialogSurfaceBrush" Color="{StaticResource PilotDialogSurfaceColor}" />
    <SolidColorBrush x:Key="PilotBorderBrush" Color="{StaticResource PilotBorderColor}" />
    <SolidColorBrush x:Key="PilotPrimaryBrush" Color="{StaticResource PilotPrimaryColor}" />
    <SolidColorBrush x:Key="PilotPrimaryHoverBrush" Color="{StaticResource PilotPrimaryHoverColor}" />
    <SolidColorBrush x:Key="PilotTextPrimaryBrush" Color="{StaticResource PilotTextPrimaryColor}" />
    <SolidColorBrush x:Key="PilotTextSecondaryBrush" Color="{StaticResource PilotTextSecondaryColor}" />
    <SolidColorBrush x:Key="PilotMenuSurfaceBrush" Color="{StaticResource PilotMenuSurfaceColor}" />
    <SolidColorBrush x:Key="PilotMenuBorderBrush" Color="{StaticResource PilotMenuBorderColor}" />
    <SolidColorBrush x:Key="PilotMenuHoverBrush" Color="{StaticResource PilotMenuHoverColor}" />
    <SolidColorBrush x:Key="PilotMenuTextBrush" Color="{StaticResource PilotMenuTextColor}" />
    <SolidColorBrush x:Key="PilotMenuMutedTextBrush" Color="{StaticResource PilotMenuMutedTextColor}" />
    <SolidColorBrush x:Key="PilotMenuIconBrush" Color="{StaticResource PilotMenuIconColor}" />
    <SolidColorBrush x:Key="PilotSuccessBrush" Color="{StaticResource PilotSuccessColor}" />
    <SolidColorBrush x:Key="PilotWarningBrush" Color="{StaticResource PilotWarningColor}" />
    <SolidColorBrush x:Key="PilotInfoBrush" Color="{StaticResource PilotInfoColor}" />
    <SolidColorBrush x:Key="PilotDangerBrush" Color="{StaticResource PilotDangerColor}" />

    <LinearGradientBrush x:Key="PilotAcrylicDepthBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0013171B" Offset="0" />
        <GradientStop Color="#12162431" Offset="0.38" />
        <GradientStop Color="#4A192848" Offset="0.72" />
        <GradientStop Color="#68281632" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="PilotSurfaceSheenBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#24FFFFFF" Offset="0" />
        <GradientStop Color="#08FFFFFF" Offset="0.45" />
        <GradientStop Color="#00141624" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>

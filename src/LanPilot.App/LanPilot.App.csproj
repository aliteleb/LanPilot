<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <AssemblyName>LanPilot</AssemblyName>
    <RootNamespace>LanPilot.App</RootNamespace>
    <ApplicationIcon>Assets\LanPilot.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\LanPilot.Contracts\LanPilot.Contracts.csproj" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="WPF-UI" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\LanPilot.ico" />
    <Resource Include="Assets\LanPilot.png" />
  </ItemGroup>
</Project>

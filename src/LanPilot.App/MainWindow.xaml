<ui:FluentWindow x:Class="LanPilot.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:local="clr-namespace:LanPilot.App"
                 Title="LanPilot"
                 Icon="/Assets/LanPilot.ico"
                 Width="1280"
                 Height="760"
                 MinWidth="980"
                 MinHeight="620"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Acrylic"
                 Background="Transparent"
                 Foreground="{DynamicResource PilotTextPrimaryBrush}">
    <ui:FluentWindow.Resources>
        <local:BooleanVisibilityConverter x:Key="BooleanVisibilityConverter" />
        <local:InverseBooleanVisibilityConverter x:Key="InverseBooleanVisibilityConverter" />
        <local:BooleanOpacityConverter x:Key="BooleanOpacityConverter" />
    </ui:FluentWindow.Resources>
    <Grid Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="72" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.ColumnSpan="2" Grid.RowSpan="2" Background="{DynamicResource PilotWindowBaseBrush}" />
        <Rectangle Grid.ColumnSpan="2" Grid.RowSpan="2" Fill="{DynamicResource PilotAcrylicDepthBrush}" />

        <Border Grid.RowSpan="2"
                Background="{DynamicResource PilotRailBrush}"
                BorderBrush="{DynamicResource PilotBorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="84" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="160" />
                </Grid.RowDefinitions>

                <Image Width="48" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Source="/Assets/LanPilot.png" RenderOptions.BitmapScalingMode="HighQuality" />

                <StackPanel Grid.Row="1">
                    <ToggleButton x:Name="OverviewNav" IsChecked="True" Style="{StaticResource PilotRailToggleStyle}" Click="OverviewNav_Click">
                        <StackPanel>
                            <Border Style="{StaticResource PilotRailIconBubbleStyle}">
                                <ui:SymbolIcon Symbol="ScanTable24" Width="32" Height="32" FontSize="26" />
                            </Border>
                            <TextBlock Text="Overview" Margin="0,3,0,0" HorizontalAlignment="Center" FontSize="11" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton x:Name="DevicesNav" Style="{StaticResource PilotRailToggleStyle}" Click="DevicesNav_Click">
                        <StackPanel>
                            <Border Style="{StaticResource PilotRailIconBubbleStyle}">
                                <ui:SymbolIcon Symbol="DesktopPulse24" Width="32" Height="32" FontSize="26" />
                            </Border>
                            <TextBlock Text="Devices" Margin="0,3,0,0" HorizontalAlignment="Center" FontSize="11" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton x:Name="RulesNav" Style="{StaticResource PilotRailToggleStyle}" Click="RulesNav_Click">
                        <StackPanel>
                            <Border Style="{StaticResource PilotRailIconBubbleStyle}">
                                <ui:SymbolIcon Symbol="ShieldTask24" Width="32" Height="32" FontSize="26" />
                            </Border>
                            <TextBlock Text="Rules" Margin="0,3,0,0" HorizontalAlignment="Center" FontSize="11" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton x:Name="ApplicationsNav" Style="{StaticResource PilotRailToggleStyle}" Click="ApplicationsNav_Click">
                        <StackPanel>
                            <Border Style="{StaticResource PilotRailIconBubbleStyle}">
                                <ui:SymbolIcon Symbol="WindowApps24" Width="32" Height="32" FontSize="26" />
                            </Border>
                            <TextBlock Text="Apps" Margin="0,3,0,0" HorizontalAlignment="Center" FontSize="11" />
                        </StackPanel>
                    </ToggleButton>
                </StackPanel>

                <StackPanel Grid.Row="2" VerticalAlignment="Bottom">
                    <ToggleButton x:Name="AboutNav" Style="{StaticResource PilotRailToggleStyle}" Click="AboutNav_Click">
                        <StackPanel>
                            <Border Style="{StaticResource PilotRailIconBubbleStyle}">
                                <ui:SymbolIcon Symbol="Info24" Width="32" Height="32" FontSize="26" />
                            </Border>
                            <TextBlock Text="About" Margin="0,3,0,0" HorizontalAlignment="Center" FontSize="11" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton x:Name="SettingsNav" Style="{StaticResource PilotRailToggleStyle}" Click="SettingsNav_Click">
                        <StackPanel>
                            <Border Style="{StaticResource PilotRailIconBubbleStyle}">
                                <ui:SymbolIcon Symbol="Settings24" Width="32" Height="32" FontSize="26" />
                            </Border>
                            <TextBlock Text="Settings" Margin="0,3,0,0" HorizontalAlignment="Center" FontSize="11" />
                        </StackPanel>
                    </ToggleButton>
                </StackPanel>
            </Grid>
        </Border>

        <ui:TitleBar Grid.Column="1" Height="36" Title="" Background="Transparent">
            <ui:TitleBar.TrailingContent>
                <StackPanel Margin="0,0,112,0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource PilotDangerBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource PilotSuccessBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsReconnecting}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource PilotWarningBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock x:Name="ServiceConnectionText" Margin="6,0,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource PilotSmallTextStyle}">
                                <Setter Property="Text" Value="Service offline" />
                                <Setter Property="Foreground" Value="{DynamicResource PilotDangerBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Text" Value="Service connected" />
                                        <Setter Property="Foreground" Value="{DynamicResource PilotSuccessBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsReconnecting}" Value="True">
                                        <Setter Property="Text" Value="Reconnecting service…" />
                                        <Setter Property="Foreground" Value="{DynamicResource PilotWarningBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <ContentControl x:Name="MainContent" Grid.Column="1" Grid.Row="1" />

        <ui:SnackbarPresenter x:Name="RootSnackbar"
                              Grid.Column="1"
                              Grid.RowSpan="2"
                              Margin="0,0,24,24"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Bottom" />

        <Grid Grid.ColumnSpan="2" Grid.RowSpan="2"
              Panel.ZIndex="100"
              Background="#B8000000"
              Visibility="{Binding IsOnboardingVisible, Converter={StaticResource BooleanVisibilityConverter}}">
            <Border Width="600"
                    MaxHeight="560"
                    Margin="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Style="{StaticResource PilotDialogCardStyle}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="28" ShadowDepth="8" Opacity="0.48" Color="#000000" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Welcome to LanPilot" Style="{StaticResource PilotHeroTextStyle}" />
                    <TextBlock Margin="0,8,0,22"
                               Text="Choose the local network you own or administer. LanPilot will never target addresses outside it."
                               Style="{StaticResource PilotBodyTextStyle}" />

                    <TextBlock Text="Network adapter" Style="{StaticResource PilotSectionTitleTextStyle}" />
                    <ComboBox Margin="0,8,0,16"
                              Height="40"
                              ItemsSource="{Binding Adapters}"
                              SelectedItem="{Binding SelectedAdapter}"
                              DisplayMemberPath="Name" />

                    <Border Margin="0,0,0,18" Padding="14" Style="{StaticResource PilotSoftCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Npcap packet driver" Style="{StaticResource PilotSectionTitleTextStyle}" />
                                <TextBlock Text="{Binding NpcapVersion, StringFormat=Detected version: {0}}" Style="{StaticResource PilotSmallTextStyle}" />
                            </StackPanel>
                            <ui:Button Grid.Column="1"
                                       Content="Get Npcap"
                                       Command="{Binding OpenNpcapDownloadCommand}"
                                       Visibility="{Binding NpcapAvailable, Converter={StaticResource InverseBooleanVisibilityConverter}}" />
                        </Grid>
                    </Border>

                    <CheckBox Margin="2,0,0,22"
                              IsChecked="{Binding AuthorizedNetwork}"
                              Content="I own or am authorized to administer this network." />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <ui:Button Appearance="Primary"
                                   MinWidth="150"
                                   Content="Scan and continue"
                                   Command="{Binding CompleteOnboardingCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.ColumnSpan="2" Grid.RowSpan="2"
              Panel.ZIndex="300"
              Background="#B8000000"
              Visibility="{Binding IsResetDeviceConfirmationVisible, Converter={StaticResource BooleanVisibilityConverter}}">
            <Border Width="520"
                    Margin="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Style="{StaticResource PilotDialogCardStyle}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="28" ShadowDepth="8" Opacity="0.48" Color="#000000" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Border Width="46" Height="46" Margin="0,0,14,0" CornerRadius="12"
                                Background="{DynamicResource PilotRouterRowBrush}">
                            <ui:SymbolIcon Symbol="ArrowSyncCircle24" Width="24" Height="24"
                                           Foreground="{DynamicResource PilotWarningBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Reset device" Style="{StaticResource PilotHeroTextStyle}" />
                            <TextBlock Text="Return this device to its default identity" Style="{StaticResource PilotSmallTextStyle}" />
                        </StackPanel>
                        <ui:Button Grid.Column="2" Width="36" Height="36" Icon="{ui:SymbolIcon Dismiss24}"
                                   Command="{Binding CancelResetDeviceCommand}" />
                    </Grid>

                    <StackPanel Grid.Row="1" Margin="0,22,0,0">
                        <TextBlock Text="{Binding PendingResetDevice.DisplayName, StringFormat=Reset {0}?}"
                                   Style="{StaticResource PilotSectionTitleTextStyle}" />
                        <TextBlock Margin="0,8,0,0"
                                   Text="The custom name, group, device limits, blocking, and usage history will be cleared. The device will move to Guests and use the group defaults."
                                   Style="{StaticResource PilotBodyTextStyle}" />
                        <Border Margin="0,16,0,0" Padding="14" CornerRadius="8"
                                Background="{DynamicResource PilotSurfaceSoftBrush}"
                                BorderBrush="{DynamicResource PilotWarningBrush}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Info24" Width="18" Height="18" Margin="0,0,9,0"
                                               Foreground="{DynamicResource PilotWarningBrush}" />
                                <TextBlock Text="This does not disconnect or block the device."
                                           VerticalAlignment="Center" Style="{StaticResource PilotSmallTextStyle}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="0,24,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                        <ui:Button Margin="0,0,8,0" Content="Cancel" Icon="{ui:SymbolIcon Dismiss24}"
                                   Command="{Binding CancelResetDeviceCommand}" />
                        <ui:Button Appearance="Danger" Content="Reset device" Icon="{ui:SymbolIcon ArrowSyncCircle24}"
                                   Command="{Binding ConfirmResetDeviceCommand}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.ColumnSpan="2" Grid.RowSpan="2"
              Panel.ZIndex="300"
              Background="#B8000000"
              Visibility="{Binding IsBlockAllConfirmationVisible, Converter={StaticResource BooleanVisibilityConverter}}">
            <Border Width="520"
                    Margin="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Style="{StaticResource PilotDialogCardStyle}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="28" ShadowDepth="8" Opacity="0.48" Color="#000000" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Border Width="46" Height="46" Margin="0,0,14,0" CornerRadius="12"
                                Background="{DynamicResource PilotRouterRowBrush}">
                            <ui:SymbolIcon Symbol="ShieldError24" Width="24" Height="24"
                                           Foreground="{DynamicResource PilotDangerBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Block internet for all?" Style="{StaticResource PilotHeroTextStyle}" />
                            <TextBlock Text="This applies immediately to every eligible online device" Style="{StaticResource PilotSmallTextStyle}" />
                        </StackPanel>
                        <ui:Button Grid.Column="2" Width="36" Height="36" Icon="{ui:SymbolIcon Dismiss24}"
                                   Command="{Binding CancelBlockAllCommand}" />
                    </Grid>
                    <TextBlock Grid.Row="1" Margin="0,22,0,0"
                               Text="The router and this PC remain protected. You can restore individual devices from the Devices page."
                               Style="{StaticResource PilotBodyTextStyle}" />
                    <StackPanel Grid.Row="2" Margin="0,24,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                        <ui:Button Margin="0,0,8,0" Content="Cancel" Icon="{ui:SymbolIcon Dismiss24}"
                                   Command="{Binding CancelBlockAllCommand}" />
                        <ui:Button Appearance="Danger" Content="Block internet" Icon="{ui:SymbolIcon ShieldError24}"
                                   Command="{Binding ConfirmBlockAllCommand}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>

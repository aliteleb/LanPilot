<UserControl x:Class="LanPilot.App.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid Style="{StaticResource PilotPageRootStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,18" Orientation="Horizontal">
            <ui:SymbolIcon Symbol="Info24" Width="30" Height="30" FontSize="26" Margin="0,0,11,0" />
            <StackPanel>
                <TextBlock Text="About LanPilot" Style="{StaticResource PilotTitleTextStyle}" />
                <TextBlock Text="Product information, open-source details, service status, and support." Style="{StaticResource PilotSmallTextStyle}" />
            </StackPanel>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Margin="0,0,0,14" Padding="24" Style="{StaticResource PilotCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="112" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Image Width="92" Height="92" HorizontalAlignment="Left" Source="/Assets/LanPilot.png" RenderOptions.BitmapScalingMode="HighQuality" />
                        <StackPanel Grid.Column="1" Margin="18,0,24,0" VerticalAlignment="Center">
                            <TextBlock Text="LanPilot" Style="{StaticResource PilotHeroTextStyle}" />
                            <TextBlock Margin="0,5,0,0" Text="{Binding ProductVersion}" Foreground="{DynamicResource PilotPrimaryBrush}" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Margin="0,8,0,0" Text="Open-source network and application bandwidth control for Windows." TextWrapping="Wrap" Style="{StaticResource PilotBodyTextStyle}" />
                            <TextBlock Margin="0,6,0,0" Text="{Binding CopyrightText}" Style="{StaticResource PilotSmallTextStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <ui:Button Margin="0,0,0,8" Appearance="Primary" Content="View on GitHub" Icon="{ui:SymbolIcon Code24}" Command="{Binding OpenProjectWebsiteCommand}" />
                            <ui:Button Content="Report an issue" Icon="{ui:SymbolIcon Bug24}" Command="{Binding OpenIssuesCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="14" /><ColumnDefinition /></Grid.ColumnDefinitions>

                    <StackPanel>
                        <Border Margin="0,0,0,14" Style="{StaticResource PilotCardStyle}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <ui:SymbolIcon Symbol="PlugConnected24" Width="22" Height="22" Margin="0,0,9,0" />
                                    <TextBlock Text="System status" Style="{StaticResource PilotSectionTitleTextStyle}" />
                                </StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="LanPilot Service" Style="{StaticResource PilotBodyTextStyle}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Margin="0,0,7,0">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{DynamicResource PilotDangerBrush}" />
                                                    <Style.Triggers><DataTrigger Binding="{Binding IsConnected}" Value="True"><Setter Property="Fill" Value="{DynamicResource PilotSuccessBrush}" /></DataTrigger></Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Offline" />
                                                    <Setter Property="Foreground" Value="{DynamicResource PilotDangerBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                            <Setter Property="Text" Value="Connected" />
                                                            <Setter Property="Foreground" Value="{DynamicResource PilotSuccessBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Packet driver" Style="{StaticResource PilotBodyTextStyle}" />
                                    <TextBlock Grid.Column="1" Text="{Binding NpcapVersion}" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Engine" Style="{StaticResource PilotBodyTextStyle}" />
                                    <TextBlock Grid.Column="1" Text="{Binding EngineMode}" />
                                </Grid>
                                <TextBlock Margin="0,14,0,0" Text="{Binding StatusMessage}" TextWrapping="Wrap" Style="{StaticResource PilotSmallTextStyle}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource PilotCardStyle}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <ui:SymbolIcon Symbol="Person24" Width="22" Height="22" Margin="0,0,9,0" />
                                    <TextBlock Text="Author and contact" Style="{StaticResource PilotSectionTitleTextStyle}" />
                                </StackPanel>
                                <TextBlock Text="Created and maintained by Ali Teleb." Style="{StaticResource PilotBodyTextStyle}" />
                                <ui:Button Margin="0,14,0,0" HorizontalAlignment="Left" Content="Contact on GitHub" Icon="{ui:SymbolIcon PersonFeedback24}" Command="{Binding OpenAuthorProfileCommand}" />
                            </StackPanel>
                        </Border>

                        <Border Margin="0,14,0,0" Style="{StaticResource PilotCardStyle}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <ui:SymbolIcon Symbol="Bug24" Width="22" Height="22" Margin="0,0,9,0" />
                                    <TextBlock Text="Crash diagnostics" Style="{StaticResource PilotSectionTitleTextStyle}" />
                                </StackPanel>
                                <TextBlock Text="LanPilot records unhandled UI, process, and background-task exceptions locally. Open this folder after a crash and inspect latest-crash.txt." TextWrapping="Wrap" Style="{StaticResource PilotBodyTextStyle}" />
                                <ui:Button Margin="0,14,0,0" HorizontalAlignment="Left" Content="Open diagnostics folder" Icon="{ui:SymbolIcon FolderOpen24}" Command="{Binding OpenDiagnosticsFolderCommand}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <Border Margin="0,0,0,14" Style="{StaticResource PilotCardStyle}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <ui:SymbolIcon Symbol="Code24" Width="22" Height="22" Margin="0,0,9,0" />
                                    <TextBlock Text="Open source" Style="{StaticResource PilotSectionTitleTextStyle}" />
                                </StackPanel>
                                <TextBlock Text="LanPilot is released under the MIT License. You may use, study, modify, and redistribute it while retaining the copyright and license notice." TextWrapping="Wrap" Style="{StaticResource PilotBodyTextStyle}" />
                                <TextBlock Margin="0,10,0,0" Text="Third-party components keep their respective licenses. Npcap is not bundled and must be installed separately." TextWrapping="Wrap" Style="{StaticResource PilotSmallTextStyle}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource PilotCardStyle}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <ui:SymbolIcon Symbol="ShieldLock24" Width="22" Height="22" Margin="0,0,9,0" />
                                    <TextBlock Text="Privacy and safety" Style="{StaticResource PilotSectionTitleTextStyle}" />
                                </StackPanel>
                                <TextBlock Text="LanPilot stores device identities, policies, and byte totals locally. It does not record packet contents, websites, domains, or DNS queries." TextWrapping="Wrap" Style="{StaticResource PilotBodyTextStyle}" />
                                <TextBlock Margin="0,10,0,0" Text="Use LanPilot only on networks you own or are authorized to administer." TextWrapping="Wrap" Foreground="{DynamicResource PilotWarningBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>

<UserControl x:Class="LanPilot.App.Views.DevicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <UserControl.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseDeviceEditorCommand}" />
    </UserControl.InputBindings>

    <Grid Style="{StaticResource PilotPageRootStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="DesktopPulse24" Width="28" Height="28" FontSize="24" Margin="0,0,10,0" />
                <StackPanel>
                    <TextBlock Text="Devices" Style="{StaticResource PilotTitleTextStyle}" />
                    <TextBlock Text="All remembered devices, their live state, and effective policies." Style="{StaticResource PilotSmallTextStyle}" />
                </StackPanel>
            </StackPanel>
            <Grid Grid.Column="1">
                <TextBox Height="36" Padding="38,0,12,0" VerticalContentAlignment="Center"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                <ui:SymbolIcon Symbol="Search24" Width="18" Height="18" Margin="12,0,0,0"
                               HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" />
            </Grid>
        </Grid>

        <Border Grid.Row="1" Margin="0,0,0,14" Padding="12" Style="{StaticResource PilotSoftCardStyle}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0">
                    <ui:ProgressRing Width="18" Height="18" Margin="0,0,8,0" IsIndeterminate="True"
                                     Visibility="{Binding ToggleControlCommand.IsRunning, Converter={StaticResource BooleanVisibilityConverter}}" />
                    <ui:Button Content="{Binding ControlButtonText}" Command="{Binding ToggleControlCommand}"
                               IsEnabled="{Binding IsConnected}" Margin="0,0,8,0" />
                    <ui:Button Content="Emergency pause" Command="{Binding EmergencyPauseCommand}"
                               IsEnabled="{Binding IsConnected}" Appearance="Danger" />
                </StackPanel>
                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" VerticalAlignment="Center"
                           Style="{StaticResource PilotSmallTextStyle}" />
            </DockPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource PilotFlatPanelStyle}">
            <Grid>
            <DataGrid x:Name="DeviceGrid" SelectedItem="{Binding SelectedDevice}"
                      MouseDoubleClick="DeviceGrid_MouseDoubleClick" AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{DynamicResource PilotBorderBrush}" AlternationCount="2"
                      RowHeight="60" ColumnHeaderHeight="42" CanUserResizeRows="False" SelectionMode="Single"
                      SelectionUnit="FullRow" EnableRowVirtualization="True" Background="Transparent" BorderThickness="0"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      ScrollViewer.CanContentScroll="True"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderBrush" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Style.Triggers>
                            <Trigger Property="AlternationIndex" Value="1">
                                <Setter Property="Background" Value="{DynamicResource PilotSurfaceSoftBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsGateway}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource PilotRouterRowBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource PilotPrimaryBrush}" />
                                <Setter Property="BorderThickness" Value="3,0,0,0" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource PilotRailSelectedBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Device" Width="*" MinWidth="220">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="DeviceMeetingRoom24" Width="17" Height="17" Margin="0,0,7,0" />
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <Border Margin="8,0,0,0" Padding="7,2" CornerRadius="8"
                                                Background="{DynamicResource PilotPrimaryBrush}"
                                                Visibility="{Binding IsGateway, Converter={StaticResource BooleanVisibilityConverter}}">
                                            <TextBlock Text="GATEWAY" FontSize="10" FontWeight="Bold" Foreground="#10141B" />
                                        </Border>
                                        <Border Margin="8,0,0,0" Padding="7,2" CornerRadius="8"
                                                Background="{DynamicResource PilotSurfaceSoftBrush}"
                                                Visibility="{Binding IsLocalComputer, Converter={StaticResource BooleanVisibilityConverter}}">
                                            <TextBlock Text="THIS PC" FontSize="10" FontWeight="SemiBold" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Margin="24,3,0,0" Text="{Binding MacAddress}" Style="{StaticResource PilotSmallTextStyle}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="IP address" Width="118">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Wifi124" Width="16" Height="16" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding Ipv4Address}" FontWeight="SemiBold" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Speed" Width="128">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center" ToolTip="Current download and upload speed">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="ArrowCircleDown24" Width="15" Height="15" Margin="0,0,6,0" Foreground="{DynamicResource PilotSuccessBrush}" />
                                        <TextBlock Text="{Binding DownloadDisplay}">
                                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource PilotTextPrimaryBrush}" /><Style.Triggers><DataTrigger Binding="{Binding DownloadTrend}" Value="Increasing"><Setter Property="Foreground" Value="{DynamicResource PilotSuccessBrush}" /></DataTrigger><DataTrigger Binding="{Binding DownloadTrend}" Value="Decreasing"><Setter Property="Foreground" Value="{DynamicResource PilotWarningBrush}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="ArrowCircleUp24" Width="15" Height="15" Margin="0,0,6,0" Foreground="{DynamicResource PilotWarningBrush}" />
                                        <TextBlock Text="{Binding UploadDisplay}">
                                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource PilotTextPrimaryBrush}" /><Style.Triggers><DataTrigger Binding="{Binding UploadTrend}" Value="Increasing"><Setter Property="Foreground" Value="{DynamicResource PilotSuccessBrush}" /></DataTrigger><DataTrigger Binding="{Binding UploadTrend}" Value="Decreasing"><Setter Property="Foreground" Value="{DynamicResource PilotWarningBrush}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Tracked usage" Width="128">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center"
                                            ToolTip="Approximate cumulative traffic observed by LanPilot for this device.">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="ArrowCircleDown24" Width="15" Height="15" Margin="0,0,6,0"
                                                       Foreground="{DynamicResource PilotSuccessBrush}" />
                                        <TextBlock Text="{Binding DownloadedData}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="ArrowCircleUp24" Width="15" Height="15" Margin="0,0,6,0"
                                                       Foreground="{DynamicResource PilotWarningBrush}" />
                                        <TextBlock Text="{Binding UploadedData}" />
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Status" Width="92">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="8" Height="8" Margin="0,0,7,0">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{DynamicResource PilotDangerBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                        <Setter Property="Fill" Value="{DynamicResource PilotSuccessBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="{Binding StatusText}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Group" Width="105">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="8" Height="8" Margin="0,0,7,0"
                                             Fill="{DynamicResource PilotWarningBrush}"
                                             ToolTip="This device uses device-specific rules instead of one or more group defaults."
                                             Visibility="{Binding HasDeviceOverrides, Converter={StaticResource BooleanVisibilityConverter}}" />
                                    <TextBlock Text="{Binding GroupName}" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Limits" Binding="{Binding LimitsText}" Width="125" />
                    <DataGridTemplateColumn Header="Blocked" Width="72">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Visibility="{Binding CanEditPolicy, Converter={StaticResource BooleanVisibilityConverter}}">
                                    <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                              IsChecked="{Binding BlockInternet, Mode=OneWay}"
                                              IsEnabled="{Binding CanToggleBlock}"
                                              Command="{Binding DataContext.ToggleDeviceBlockCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                              CommandParameter="{Binding}"
                                              ToolTip="Block or restore internet"
                                              Visibility="{Binding IsBlockPending, Converter={StaticResource InverseBooleanVisibilityConverter}}" />
                                    <ui:ProgressRing Width="18" Height="18" IsIndeterminate="True"
                                                     Visibility="{Binding IsBlockPending, Converter={StaticResource BooleanVisibilityConverter}}" />
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Actions" Width="104">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                                Visibility="{Binding CanEditPolicy, Converter={StaticResource BooleanVisibilityConverter}}">
                                        <ui:Button Width="36" Height="34" ToolTip="Edit device"
                                                   Icon="{ui:SymbolIcon EditSettings24}"
                                                   Command="{Binding DataContext.EditDeviceCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                   CommandParameter="{Binding}" />
                                        <ui:Button Margin="6,0,0,0" Width="36" Height="34"
                                                   Icon="{ui:SymbolIcon ArrowSyncCircle24}"
                                                   Command="{Binding DataContext.ResetDeviceCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                   CommandParameter="{Binding}"
                                                   ToolTip="Forget custom settings and treat this device as new" />
                                    </StackPanel>
                                    <TextBlock Text="Protected" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{DynamicResource PilotTextSecondaryBrush}" FontSize="11"
                                               Visibility="{Binding IsProtected, Converter={StaticResource BooleanVisibilityConverter}}" />
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
                <StackPanel x:Name="DevicesLoadingOverlay"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            IsHitTestVisible="False">
                    <ui:ProgressRing Width="42" Height="42" HorizontalAlignment="Center" IsIndeterminate="True" />
                    <TextBlock Margin="0,11,0,0" Text="Loading devices…"
                               HorizontalAlignment="Center" Style="{StaticResource PilotBodyTextStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.RowSpan="3" Panel.ZIndex="100" Margin="-18,-10,-18,-18" Background="#B8000000"
              Visibility="{Binding IsDeviceEditorVisible, Converter={StaticResource BooleanVisibilityConverter}}">
            <Border Width="570" MaxHeight="660" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Style="{StaticResource PilotDialogCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="42" Height="42" Margin="0,0,12,0" CornerRadius="10" Background="{DynamicResource PilotRouterRowBrush}">
                                <ui:SymbolIcon Symbol="EditSettings24" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel>
                                <TextBlock Text="Edit device" Style="{StaticResource PilotHeroTextStyle}" />
                                <TextBlock Text="{Binding SelectedDevice.MacAddress}" Style="{StaticResource PilotSmallTextStyle}" />
                            </StackPanel>
                        </StackPanel>
                        <ui:Button Grid.Column="1" Width="36" Height="36" Icon="{ui:SymbolIcon Dismiss24}"
                                   Command="{Binding CloseDeviceEditorCommand}" />
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="Name" Style="{StaticResource PilotSmallTextStyle}" />
                            <TextBox Margin="0,5,0,12" Height="36" Text="{Binding EditName}" />
                            <TextBlock Text="Type" Style="{StaticResource PilotSmallTextStyle}" />
                            <ComboBox Margin="0,5,0,12" Height="36" ItemsSource="{Binding DeviceTypes}" SelectedItem="{Binding EditDeviceType}" />
                            <Border Margin="0,2,0,14" Padding="14" Style="{StaticResource PilotSoftCardStyle}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="ShieldError24" Width="18" Height="18" Margin="0,0,8,0" />
                                        <CheckBox Content="Block internet" IsChecked="{Binding EditBlocked}" />
                                    </StackPanel>
                                    <TextBlock Margin="26,5,0,0" Text="Limits and blocking are applied immediately after saving."
                                               Style="{StaticResource PilotSmallTextStyle}" />
                                </StackPanel>
                            </Border>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="14" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="ArrowCircleDown24" Width="16" Height="16" Margin="0,0,6,0" />
                                        <TextBlock Text="Download limit (Mbps)" Style="{StaticResource PilotSmallTextStyle}" />
                                    </StackPanel>
                                    <TextBox Margin="0,5,0,12" Height="36" Text="{Binding EditDownloadLimit}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="ArrowCircleUp24" Width="16" Height="16" Margin="0,0,6,0" />
                                        <TextBlock Text="Upload limit (Mbps)" Style="{StaticResource PilotSmallTextStyle}" />
                                    </StackPanel>
                                    <TextBox Margin="0,5,0,12" Height="36" Text="{Binding EditUploadLimit}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Priority" Style="{StaticResource PilotSmallTextStyle}" />
                            <ComboBox Margin="0,5,0,12" Height="36" ItemsSource="{Binding Priorities}" SelectedItem="{Binding EditPriority}" />
                            <TextBlock Text="Group" Style="{StaticResource PilotSmallTextStyle}" />
                            <ComboBox Margin="0,5,0,4" Height="36" ItemsSource="{Binding Groups}" SelectedItem="{Binding EditGroup}" DisplayMemberPath="Name" />
                        </StackPanel>
                    </ScrollViewer>
                    <StackPanel Grid.Row="2" Margin="0,20,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                        <ui:Button Margin="0,0,8,0" Content="Use group defaults" Icon="{ui:SymbolIcon ArrowSyncCircle24}"
                                   Command="{Binding ResetEditorToGroupDefaultsCommand}"
                                   ToolTip="Clear device-specific blocking and limits; changes apply when you save." />
                        <ui:Button Margin="0,0,8,0" Content="Cancel" Icon="{ui:SymbolIcon Dismiss24}"
                                   Command="{Binding CloseDeviceEditorCommand}" />
                        <ui:Button Appearance="Primary" Content="Save changes" Icon="{ui:SymbolIcon DocumentSave24}"
                                   Command="{Binding SaveSelectedDeviceCommand}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>

<UserControl x:Class="LanPilot.App.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid Style="{StaticResource PilotPageRootStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="Router24" Width="28" Height="28" FontSize="24" Margin="0,0,10,0" />
                <StackPanel>
                    <TextBlock Text="Network overview" Style="{StaticResource PilotTitleTextStyle}" />
                    <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                        <ui:ProgressRing Width="16" Height="16" Margin="0,0,7,0"
                                         IsIndeterminate="True"
                                         Visibility="{Binding IsScanning, Converter={StaticResource BooleanVisibilityConverter}}" />
                        <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Style="{StaticResource PilotBodyTextStyle}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <ui:Button Margin="0,0,8,0"
                           Content="Reconnect service"
                           Icon="{ui:SymbolIcon PlugConnected24}"
                           Command="{Binding InitializeCommand}"
                           Visibility="{Binding IsConnected, Converter={StaticResource InverseBooleanVisibilityConverter}}" />
                <ui:Button Margin="0,0,8,0" Content="Scan network" Icon="{ui:SymbolIcon ScanTable24}" Command="{Binding ScanCommand}" IsEnabled="{Binding CanScan}" />
                <ui:Button Margin="0,0,8,0" Appearance="Primary" Content="{Binding ControlButtonText}" Icon="{ui:SymbolIcon PauseCircle24}" Command="{Binding ToggleControlCommand}" IsEnabled="{Binding IsConnected}" />
                <ui:Button Appearance="Danger" Content="Emergency pause" Icon="{ui:SymbolIcon ShieldError24}" Command="{Binding EmergencyPauseCommand}" IsEnabled="{Binding IsConnected}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Margin="0,0,0,16" Padding="14" Style="{StaticResource PilotSoftCardStyle}">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="Info24" Width="18" Height="18" />
                <TextBlock Margin="8,0,0,0" Text="IPv6 traffic is visible but not controlled in LanPilot 0.1."
                           Style="{StaticResource PilotSmallTextStyle}"
                           Visibility="{Binding Ipv6Detected, Converter={StaticResource BooleanVisibilityConverter}}" />
                <TextBlock Margin="8,0,0,0" Text="Npcap is missing. Install it to enable bandwidth control."
                           Style="{StaticResource PilotSmallTextStyle}"
                           Visibility="{Binding NpcapAvailable, Converter={StaticResource InverseBooleanVisibilityConverter}}" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Margin="0,0,0,16">
            <UniformGrid Columns="4" Margin="0,0,0,10">
                <Border Margin="0,0,8,0" Style="{StaticResource PilotSoftCardStyle}">
                    <StackPanel><ui:SymbolIcon Symbol="DesktopPulse24" Width="19" Height="19" HorizontalAlignment="Left" /><TextBlock Text="{Binding OnlineCount}" Style="{StaticResource PilotMetricValueStyle}" /><TextBlock Text="Online devices" Style="{StaticResource PilotSmallTextStyle}" /></StackPanel>
                </Border>
                <Border Margin="4,0" Style="{StaticResource PilotSoftCardStyle}">
                    <StackPanel><ui:SymbolIcon Symbol="ShieldError24" Width="19" Height="19" HorizontalAlignment="Left" /><TextBlock Text="{Binding BlockedCount}" Style="{StaticResource PilotMetricValueStyle}" /><TextBlock Text="Blocked devices" Style="{StaticResource PilotSmallTextStyle}" /></StackPanel>
                </Border>
                <Border Margin="4,0" Style="{StaticResource PilotSoftCardStyle}">
                    <StackPanel><ui:SymbolIcon Symbol="ArrowCircleDown24" Width="19" Height="19" HorizontalAlignment="Left" /><TextBlock Margin="0,7,0,0" Text="{Binding TotalDownloadText}" Style="{StaticResource PilotSectionTitleTextStyle}" /><TextBlock Text="Device download now" Style="{StaticResource PilotSmallTextStyle}" /></StackPanel>
                </Border>
                <Border Margin="8,0,0,0" Style="{StaticResource PilotSoftCardStyle}">
                    <StackPanel><ui:SymbolIcon Symbol="ArrowCircleUp24" Width="19" Height="19" HorizontalAlignment="Left" /><TextBlock Margin="0,7,0,0" Text="{Binding TotalUploadText}" Style="{StaticResource PilotSectionTitleTextStyle}" /><TextBlock Text="Device upload now" Style="{StaticResource PilotSmallTextStyle}" /></StackPanel>
                </Border>
            </UniformGrid>

            <UniformGrid Columns="5">
                <Border Margin="0,0,8,0" Style="{StaticResource PilotSoftCardStyle}">
                    <StackPanel><ui:SymbolIcon Symbol="WindowApps24" Width="19" Height="19" HorizontalAlignment="Left" /><TextBlock Text="{Binding RunningApplicationCount}" Style="{StaticResource PilotMetricValueStyle}" /><TextBlock Text="Running apps" Style="{StaticResource PilotSmallTextStyle}" /></StackPanel>
                </Border>
                <Border Margin="4,0" Style="{StaticResource PilotSoftCardStyle}">
                    <StackPanel><ui:SymbolIcon Symbol="TopSpeed24" Width="19" Height="19" HorizontalAlignment="Left" /><TextBlock Text="{Binding RestrictedApplicationCount}" Style="{StaticResource PilotMetricValueStyle}" /><TextBlock Text="Restricted apps" Style="{StaticResource PilotSmallTextStyle}" /></StackPanel>
                </Border>
                <Border Margin="4,0" Style="{StaticResource PilotSoftCardStyle}">
                    <StackPanel><ui:SymbolIcon Symbol="ShieldError24" Width="19" Height="19" HorizontalAlignment="Left" Foreground="{DynamicResource PilotDangerBrush}" /><TextBlock Text="{Binding BlockedApplicationCount}" Style="{StaticResource PilotMetricValueStyle}" /><TextBlock Text="Blocked apps" Style="{StaticResource PilotSmallTextStyle}" /></StackPanel>
                </Border>
                <Border Margin="4,0" Style="{StaticResource PilotSoftCardStyle}">
                    <StackPanel><ui:SymbolIcon Symbol="ArrowCircleDown24" Width="19" Height="19" HorizontalAlignment="Left" Foreground="{DynamicResource PilotSuccessBrush}" /><TextBlock Margin="0,7,0,0" Text="{Binding ApplicationDownloadText}" Style="{StaticResource PilotSectionTitleTextStyle}" /><TextBlock Text="App download now" Style="{StaticResource PilotSmallTextStyle}" /></StackPanel>
                </Border>
                <Border Margin="8,0,0,0" Style="{StaticResource PilotSoftCardStyle}">
                    <StackPanel><ui:SymbolIcon Symbol="ArrowCircleUp24" Width="19" Height="19" HorizontalAlignment="Left" Foreground="{DynamicResource PilotWarningBrush}" /><TextBlock Margin="0,7,0,0" Text="{Binding ApplicationUploadText}" Style="{StaticResource PilotSectionTitleTextStyle}" /><TextBlock Text="App upload now" Style="{StaticResource PilotSmallTextStyle}" /></StackPanel>
                </Border>
            </UniformGrid>
        </StackPanel>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Margin="0,0,8,0" Style="{StaticResource PilotCardStyle}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="88" />
                                <ColumnDefinition Width="82" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Recently seen devices" Style="{StaticResource PilotSectionTitleTextStyle}" />
                            <TextBlock Grid.Column="1" Text="DOWNLOAD" Style="{StaticResource PilotSmallTextStyle}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="2" Text="UPLOAD" Style="{StaticResource PilotSmallTextStyle}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="3" Text="STATUS" Style="{StaticResource PilotSmallTextStyle}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="4" Text="ACTION" Style="{StaticResource PilotSmallTextStyle}" FontWeight="SemiBold" />
                        </Grid>
                        <Border Height="1" Margin="0,0,0,8" Background="{DynamicResource PilotBorderBrush}" />
                    </StackPanel>
                    <Grid>
                    <ListBox ItemsSource="{Binding Devices}"
                             SelectedItem="{Binding SelectedDevice}"
                             BorderThickness="0"
                             Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,5" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="SelectionSurface"
                                                    Padding="12,9"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{DynamicResource PilotBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="6">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="SelectionSurface" Property="Background" Value="{DynamicResource PilotSurfaceSoftBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="SelectionSurface" Property="BorderBrush" Value="{DynamicResource PilotPrimaryBrush}" />
                                                    <Setter TargetName="SelectionSurface" Property="BorderThickness" Value="1.5" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOnline}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="DeviceRow" Margin="-12,-9" Padding="12,9" CornerRadius="6" Background="Transparent">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="88" />
                                            <ColumnDefinition Width="82" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                <Border x:Name="GatewayBadge"
                                                        Margin="8,0,0,0"
                                                        Padding="7,2"
                                                        CornerRadius="8"
                                                        Background="{DynamicResource PilotPrimaryBrush}"
                                                        Visibility="Collapsed">
                                                    <TextBlock Text="GATEWAY" FontSize="10" FontWeight="Bold" Foreground="#10141B" />
                                                </Border>
                                                <Border Margin="8,0,0,0"
                                                        Padding="7,2"
                                                        CornerRadius="8"
                                                        Background="{DynamicResource PilotSurfaceSoftBrush}"
                                                        Visibility="{Binding IsLocalComputer, Converter={StaticResource BooleanVisibilityConverter}}">
                                                    <TextBlock Text="THIS PC" FontSize="10" FontWeight="SemiBold" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock x:Name="DeviceIpText" Margin="0,3,0,0" Text="{Binding Ipv4Address}" Style="{StaticResource PilotSmallTextStyle}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DownloadDisplay}" FontWeight="SemiBold">
                                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource PilotTextPrimaryBrush}" /><Style.Triggers><DataTrigger Binding="{Binding DownloadTrend}" Value="Increasing"><Setter Property="Foreground" Value="{DynamicResource PilotSuccessBrush}" /></DataTrigger><DataTrigger Binding="{Binding DownloadTrend}" Value="Decreasing"><Setter Property="Foreground" Value="{DynamicResource PilotWarningBrush}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding UploadDisplay}" FontWeight="SemiBold">
                                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource PilotTextPrimaryBrush}" /><Style.Triggers><DataTrigger Binding="{Binding UploadTrend}" Value="Increasing"><Setter Property="Foreground" Value="{DynamicResource PilotSuccessBrush}" /></DataTrigger><DataTrigger Binding="{Binding UploadTrend}" Value="Decreasing"><Setter Property="Foreground" Value="{DynamicResource PilotWarningBrush}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="7" Height="7" Margin="0,0,7,0">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{DynamicResource PilotDangerBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                                <Setter Property="Fill" Value="{DynamicResource PilotSuccessBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="{Binding StatusText}" />
                                        </StackPanel>
                                        <ui:Button Grid.Column="4"
                                                   MinWidth="64"
                                                   Padding="10,5"
                                                   Content="{Binding ActionText}"
                                                   Command="{Binding DataContext.EditDeviceCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                   CommandParameter="{Binding}"
                                                   Visibility="{Binding CanEditPolicy, Converter={StaticResource BooleanVisibilityConverter}}" />
                                        <TextBlock Grid.Column="4"
                                                   Text="Protected"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource PilotTextSecondaryBrush}"
                                                   FontSize="11"
                                                   Visibility="{Binding IsProtected, Converter={StaticResource BooleanVisibilityConverter}}" />
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsGateway}" Value="True">
                                        <Setter TargetName="DeviceRow" Property="Background" Value="{DynamicResource PilotRouterRowBrush}" />
                                        <Setter TargetName="GatewayBadge" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                        <Setter TargetName="DeviceIpText" Property="Foreground" Value="{DynamicResource PilotTextPrimaryBrush}" />
                                        <Setter TargetName="DeviceIpText" Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    IsHitTestVisible="False"
                                    Visibility="{Binding IsScanning, Converter={StaticResource BooleanVisibilityConverter}}">
                            <ui:ProgressRing Width="44" Height="44" HorizontalAlignment="Center" IsIndeterminate="True" />
                            <TextBlock Margin="0,12,0,0" Text="Scanning devices…"
                                       HorizontalAlignment="Center" Style="{StaticResource PilotBodyTextStyle}" />
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </Border>
            <Border Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource PilotCardStyle}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="WindowApps24" Width="22" Height="22" Margin="0,0,9,0" />
                        <TextBlock Text="Application control" Style="{StaticResource PilotSectionTitleTextStyle}" />
                    </StackPanel>
                    <TextBlock Margin="0,6,0,18" Text="Live traffic and policies for applications on this computer." TextWrapping="Wrap" Style="{StaticResource PilotBodyTextStyle}" />

                    <Border Padding="12" Margin="0,0,0,14" Style="{StaticResource PilotSoftCardStyle}">
                        <StackPanel>
                            <TextBlock Text="MOST ACTIVE NOW" FontWeight="SemiBold" Style="{StaticResource PilotSmallTextStyle}" />
                            <TextBlock Margin="0,8,0,0" Text="{Binding MostActiveApplicationName}" TextTrimming="CharacterEllipsis" Style="{StaticResource PilotSectionTitleTextStyle}" />
                            <TextBlock Margin="0,5,0,0" Text="{Binding MostActiveApplicationTrafficText}" Style="{StaticResource PilotSmallTextStyle}" />
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding RunningApplicationCount}" Style="{StaticResource PilotMetricValueStyle}" />
                            <TextBlock Text="Running" Style="{StaticResource PilotSmallTextStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding RestrictedApplicationCount}" Style="{StaticResource PilotMetricValueStyle}" />
                            <TextBlock Text="With policies" Style="{StaticResource PilotSmallTextStyle}" />
                        </StackPanel>
                    </Grid>

                    <ui:Button Margin="0,0,0,8" Appearance="Primary" Content="Open app control" Icon="{ui:SymbolIcon WindowApps24}" Command="{Binding OpenApplicationControlCommand}" />
                    <ui:Button Content="Refresh applications" Icon="{ui:SymbolIcon ArrowSyncCircle24}" Command="{Binding RefreshApplicationsCommand}" IsEnabled="{Binding CanRefreshApplications}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
